{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interlock",
  "version": "0.1.0",
  "identifier": "dev.interlock.app",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../../packages/app/dist",
    "beforeDevCommand": "npm run dev -w @interlock/app -- --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build -w @interlock/app"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Interlock",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
