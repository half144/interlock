{
  "name": "@interlock/client",
  "version": "0.1.0",
  "description": "Interlock client SDK package",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/daemon-client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./internal/daemon-client-transport-types": {
      "types": "./dist/daemon-client-transport-types.d.ts",
      "default": "./dist/daemon-client-transport-types.js"
    },
    "./internal/daemon-client-websocket-transport": {
      "types": "./dist/daemon-client-websocket-transport.d.ts",
      "default": "./dist/daemon-client-websocket-transport.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run build --workspace=@interlock/protocol && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@interlock/protocol": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  }
}
